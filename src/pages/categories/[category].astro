---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import PostCard from "@components/PostCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategories, getPostsByCategory } from "@utils/content-utils";
import { getCategoryUrl, getPostUrlBySlug } from "@utils/url-utils";

export const getStaticPaths = (async () => {
    const categories = await getCategories();
    return categories.map((cat) => ({
        params: { category: cat.name },
    }));
}) satisfies GetStaticPaths;

const { category } = Astro.params;
const posts = await getPostsByCategory(category);
---

<MainGridLayout title={`分类：${category}`}>
    <div class="flex flex-col gap-4">
        <div class="card-base px-8 py-4 flex items-center gap-3">
            <a href="/categories/"
               class="flex items-center gap-1 text-sm text-50 hover:text-[var(--primary)] transition">
                <Icon name="material-symbols:arrow-back-rounded" class="text-base"></Icon>
                所有分类
            </a>
            <span class="text-30">/</span>
            <div class="flex items-center gap-2">
                <Icon name="material-symbols:folder-open-outline" class="text-lg text-[var(--primary)]"></Icon>
                <span class="font-bold text-75">{category}</span>
                <span class="text-xs text-50 bg-[var(--primary)] text-white rounded-full px-2 py-0.5 font-medium">
                    {posts.length} 篇
                </span>
            </div>
        </div>

        {posts.length === 0 ? (
            <div class="card-base px-8 py-6 text-50 text-sm">该分类下暂无文章</div>
        ) : (
            posts.map((entry, i) => (
                <PostCard
                    entry={entry}
                    title={entry.data.title}
                    published={entry.data.published}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.slug)}
                    image={entry.data.image}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    class="onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${i * 50}ms);`}
                ></PostCard>
            ))
        )}
    </div>
</MainGridLayout>
